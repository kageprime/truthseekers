{
  "name": "encarta-me",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/storage",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "build:core": "tsc --build packages/core",
    "build:storage": "tsc --build packages/storage",
    "build:server": "tsc --build packages/server",
    "build:cli": "tsc --build packages/cli",
    "build": "tsc --build packages/core packages/storage packages/server packages/cli",
    "build:web": "cd packages/web && npm run build",
    "typecheck": "tsc --build packages/core packages/storage packages/server packages/cli",
    "seed": "node packages/cli/dist/seed.js",
    "generate": "node packages/cli/dist/generate.js",
    "dev": "concurrently -k \"node packages/server/dist/index.js\" \"cd packages/web && npm run dev\"",
    "opencode:start": "opencode serve --port 4098 --hostname 127.0.0.1 --model opencode/deepseek-v4-flash-free",
    "opencode:stop": "taskkill /f /im kilo.exe 2>nul & taskkill /f /im opencode.exe 2>nul & echo done",
    "dev:full": "concurrently -k \"opencode serve --port 4098 --hostname 127.0.0.1 --model opencode/deepseek-v4-flash-free\" \"node packages/server/dist/index.js\" \"cd packages/web && npm run dev\"",
    "clean": "npx rimraf packages/*/dist packages/*/.next node_modules",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "mermaid": "^11.15.0"
  }
}
