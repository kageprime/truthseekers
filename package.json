{
  "name": "encarta-me",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/web"
  ],
  "scripts": {
    "build:core": "tsc --build packages/core",
    "build": "tsc --build packages/core",
    "build:web": "cd packages/web && npm run build",
    "build:go": "cd veritas/go-orchestrator && \"C:\\Program Files\\Go\\bin\\go.exe\" build -o server.exe ./cmd/server",
    "typecheck": "tsc --build packages/core && cd packages/web && tsc --noEmit",
    "dev:go": "cd veritas/go-orchestrator && \"C:\\Program Files\\Go\\bin\\go.exe\" run cmd/server/main.go",
    "dev:go:web": "concurrently -k \"cd veritas/go-orchestrator && \\\"C:\\Program Files\\Go\\bin\\go.exe\\\" run cmd/server/main.go\" \"cd packages/web && npm run dev\"",
    "clean": "npx rimraf packages/*/dist packages/*/.next node_modules"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
