{
  "name": "@encarta/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@encarta/core": "*",
    "@encarta/storage": "*",
    "@hono/node-server": "^1.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.0.0",
    "@upstash/redis": "^1.34.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "better-sqlite3": "^12.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
