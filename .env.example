# Encarta-Me Environment Variables
# Copy to .env and fill in your keys

# OpenCode server URL
OPENCODE_SERVER_URL=http://localhost:4096

# API Server
PORT=4097
CORS_ORIGIN=*
NODE_ENV=development

# Auth (comma-separated API keys, leave empty to disable)
ENCARTA_API_KEYS=

# Rate limiting
RATE_LIMIT=60

# Concurrency
ENCARTA_MAX_CONCURRENT=3
ENCARTA_MAX_QUEUE=100

# Storage
ENCARTA_DB_PATH=./encarta.db
ENCARTA_REPO_PATH=./data/encyclopedia
ENCARTA_VECTOR_PATH=./encarta_vectors.db

# Web - API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:4097

# CORS origin for API server (set this to your Vercel web app URL)
CORS_ORIGIN=https://truthseeker-web.vercel.app

# Firecrawl for web search (set in opencode.json via MCP)
FIRECRAWL_API_KEY=

# OpenAI for image generation (Milestone 3)
OPENAI_API_KEY=

#nic