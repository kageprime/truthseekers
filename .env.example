# Truthseekers / VERITAS Environment Variables
# Copy to .env and fill in your keys
# Place at repo root (../.env relative to go-orchestrator)

# — API Server —
PORT=4097
CORS_ORIGIN=*
# Required (server panics without it unless ALLOW_DEV_AUTH=1 for local dev)
JWT_SECRET=
# ALLOW_DEV_AUTH=1

# — Storage —
# Leave unset for file-backed mock mode (loads data/encyclopedia/*.json)
DATABASE_URL=

# — LLM Providers —
# Meta Model API (default: muse-spark-1.3-contributor, OpenAI-compatible at https://api.meta.ai/v1)
MODEL_API_KEY=
# DigitalOcean Inference (legacy fallback)
MODEL_ACCESS_KEY=
# Groq (legacy fallback)
GROQ_API_KEY=

# — Web Search (enables real web retrieval in the epistemic pipeline) —
# When either is set, the retrieve node fetches live search results + URL content
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# — Email OTP login (Resend) —
# Without RESEND_API_KEY, codes are logged server-side only under ALLOW_DEV_AUTH=1
RESEND_API_KEY=
# RESEND_FROM="Truthseekers <login@yourdomain.com>"

# — QStash (Upstash message queue; not yet wired to any code path) —
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# — Web —
NEXT_PUBLIC_API_URL=http://localhost:4097
ENCARTA_IMAGE_DIR=public/images
# VERITAS Environment Variables
# Copy to .env and fill in your keys

# --- VERITAS Go Orchestrator & Python Workers ---

# OpenAI API Key for Python workers (Claim Extraction, Critique, etc.)
OPENAI_API_KEY=

# PostgreSQL database connection URL for Go Orchestrator
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/veritas?sslmode=disable

# Go API Server Port
PORT=4097
CORS_ORIGIN=*

# Web - API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:4097

# Firecrawl for web search
FIRECRAWL_API_KEY=

# ========================================================
# LLM Provider Chain (tried in order, first to return wins)
# ========================================================

# 1) Groq (primary)
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3-32b

# 2) DigitalOcean Inference (fallback)
MODEL_ACCESS_KEY=your_do_key_here
DO_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL=gemma-4-31B-it

# 3) NVIDIA NIM (second fallback)
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# 4) OpenAI (last fallback)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DO AI for image generation
DO_AI_URL=https://inference.do-ai.run/v1/images/generations